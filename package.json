{
  "name": "plotter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "bun scripts/build-docs.ts && next build",
    "start": "next start --port 3000",
    "downloads": "bun scripts/build-plotter-downloads.tsx && bun scripts/build-docs.ts",
    "drawings": "node scripts/build-plotter-registration.mjs && python3 scripts/build-plotter-drawings.py",
    "grammar": "python3 scripts/build-plotter-grammar.py"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.555.0",
    "next": "16.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "bun-types": "1.3.4",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
