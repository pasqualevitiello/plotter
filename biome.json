{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/*.svg",
      "!**/*.html",
      "!bun.lock",
      "!next-env.d.ts",
      "!public",
      "!skills/plotter/references/history",
      "!skills/plotter/references/catalogue",
      "!components/plotter/expanded-studies.tsx",
      "!components/plotter/visual-grammar-drawings.tsx",
      "!skills/plotter/assets/foundation/roles.css",
      "!skills/plotter/assets/foundation/standard.mjs",
      "!skills/plotter/references/drafting-standard.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "proseWrap": "preserve",
      "formatEmbeds": false
    }
  },
  "tailwind": {
    "stylesheet": "./app/globals.css"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:"],
              "@/**",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": "warn"
      },
      "preset": "recommended"
    }
  }
}
